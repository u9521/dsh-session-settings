{
  "name": "@local/dsh-session-settings",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Session settings, MCP servers, and Skill management plugin for DeepSeek Harness (DSH) Web GUI.",
  "author": "u9521",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/u9521/dsh-session-settings.git"
  },
  "bugs": {
    "url": "https://github.com/u9521/dsh-session-settings/issues"
  },
  "homepage": "https://github.com/u9521/dsh-session-settings#readme",
  "main": "lib/index.js",
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": "^22.19 || >=24",
    "dsh": ">=0.1.5-rc.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-api-remotes"
      ],
      "platform": "web"
    }
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "subagent",
    "model"
  ],
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.0.0"
  }
}
