{
  "name": "@local/dsh-session-settings",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Session settings, MCP servers, and Skill management plugin for DeepSeek Harness (DSH) Web GUI.",
  "author": "u9521",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/u9521/dsh-session-settings.git"
  },
  "bugs": {
    "url": "https://github.com/u9521/dsh-session-settings/issues"
  },
  "homepage": "https://github.com/u9521/dsh-session-settings#readme",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "engines": {
    "node": "^22.19 || >=24",
    "dsh": ">=0.1.2-rc.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-api-remotes"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node scripts/build.mjs --check",
    "fmt": "prettier --write \"src/**/*.ts\" \"scripts/*.mjs\" \"*.mjs\" \"*.json\" \"*.yml\"",
    "fmt:check": "prettier --check \"src/**/*.ts\" \"scripts/*.mjs\" \"*.mjs\" \"*.json\" \"*.yml\"",
    "sync": "node scripts/sync-tsdown.mjs"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "subagent",
    "model"
  ],
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.2-rc.1",
    "@types/node": "^26.2.0",
    "@types/react": "^18.3.1",
    "lightningcss": "^1.33.0",
    "prettier": "^3.9.6",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2"
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.0.0"
  }
}
