{
  "name": "@local/dsh-session-settings",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Session settings, MCP servers, and Skill management plugin for DeepSeek Harness (DSH) Web GUI.",
  "author": "u9521",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/u9521/dsh-session-settings.git"
  },
  "bugs": {
    "url": "https://github.com/u9521/dsh-session-settings/issues"
  },
  "homepage": "https://github.com/u9521/dsh-session-settings#readme",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "engines": {
    "node": "^22.19 || >=24"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.2.0-rc.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-api-remotes"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node scripts/build.mjs --check",
    "verify:gates": "node scripts/gates/verify-agent-note-format.mjs && node scripts/gates/verify-doc-budgets.mjs && node scripts/gates/verify-md-links.mjs && node scripts/gates/verify-agent-skills.mjs",
    "verify": "pnpm run check && pnpm run verify:gates",
    "fmt": "prettier --write \"src/**/*.ts\" \"scripts/**/*.mjs\" \"*.mjs\" \"*.json\" \"*.yml\"",
    "fmt:check": "prettier --check \"src/**/*.ts\" \"scripts/**/*.mjs\" \"*.mjs\" \"*.json\" \"*.yml\""
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "subagent",
    "model"
  ],
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.0-rc.1",
    "@types/node": "^26.6.2",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "prettier": "^3.9.9",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2"
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.0.0"
  }
}
